# Copy to .env (git-ignored). Environment variables override config.json.
OPENROUTER_API_KEY=sk-or-your-key-here

# Password required to open the web UI. Sessions live in memory only, so
# restarting the server signs everyone out. Leave empty to disable the gate.
GENESIS_PASSWORD=change-me

# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GENESIS_MODEL=openai/gpt-4o-mini
# GENESIS_ADDR=127.0.0.1:8080
# GENESIS_DATA_DIR=.
# GENESIS_REASONING_EFFORT=off
# GENESIS_SPEECH_MODEL=openai/gpt-4o-mini-tts
# GENESIS_SPEECH_VOICE=alloy
